{
  "rules": {
    "trip": {
      ".read": true,
      "$doc": {
        ".write": "newData.exists()",
        ".validate": "newData.hasChildren() && newData.child('_ts').isNumber()"
      },
      "members": {
        ".write": "newData.exists()",
        ".validate": "newData.hasChildren() && newData.child('_ts').isNumber() && newData.child('items').child('0').exists()"
      },
      "itinerary": {
        ".write": "newData.exists()",
        ".validate": "newData.hasChildren() && newData.child('_ts').isNumber() && newData.child('items').child('0').exists()"
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
